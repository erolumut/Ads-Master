{
  "pxeVersion": "0.1",
  "policyRevision": 1,
  "product": "bad-example",
  "audience": { "minimumAge": 13, "minorsTier": "lenient" },
  "modes": [
    { "id": "daily", "shared": true },
    { "id": "levels", "shared": false }
  ],
  "difficulty": { "steps": [-2, -1, 0, 1, 2], "default": 0, "minOffset": -1, "maxOffset": 1 },
  "player": { "settings": ["auto", "easy", "normal", "hard"], "explain": true, "log": true, "reset": true },
  "rules": [
    {
      "id": "ease_for_big_spenders",
      "modes": ["levels"],
      "when": [ { "input": "spend_last_7d", "op": ">=", "value": 5 } ],
      "then": { "action": "difficulty_offset", "value": -1 },
      "reason": "retention",
      "explainKey": "pxe.reason.retention",
      "maxPerSession": 1
    },
    {
      "id": "daily_adapts",
      "modes": ["daily"],
      "when": [ { "input": "fail_streak", "op": ">=", "value": 2 } ],
      "then": { "action": "offer_hint" },
      "reason": "struggling",
      "explainKey": "pxe.reason.struggling",
      "maxPerSession": 1
    },
    {
      "id": "make_them_lose",
      "modes": ["levels"],
      "when": [ { "input": "fast_solve_streak", "op": ">=", "value": 3 } ],
      "then": { "action": "force_loss" },
      "reason": "cruising",
      "explainKey": "pxe.reason.cruising",
      "maxPerSession": 1
    }
  ],
  "returnReasons": [
    { "id": "keep_your_streak", "source": "streak", "maxPerDay": 2, "quietHours": ["21:00", "09:00"] }
  ],
  "scores": { "modifyAfterFact": true, "assistedRunsLabeled": true, "assistedRunsOnSharedBoards": false },
  "experiment": { "holdoutPercent": 0, "readAfterDays": 56, "primary": ["d7_retention"], "guardrails": ["quit_after_fail_rate"] }
}
