{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ads-master/game-monetization/monetization-policy.schema.json",
  "title": "Game monetization policy (contract 0.1)",
  "description": "One file per game. Read by the game's code and by monetization_check.py. The structural rules are here; the fairness and consumer rules are in monetization_check.py.",
  "type": "object",
  "required": ["contractVersion", "game", "currencies", "modes", "catalog", "offers", "placements", "consent", "storeDeclarations", "killSwitch"],
  "properties": {
    "contractVersion": { "type": "string", "pattern": "^0\\.[0-9]+$" },
    "game": {
      "type": "object",
      "required": ["id", "platforms", "audience"],
      "properties": {
        "id": { "type": "string" },
        "platforms": { "type": "array", "items": { "enum": ["web", "pwa", "ios", "android", "desktop"] }, "minItems": 1 },
        "audience": {
          "type": "object",
          "required": ["minimumAge", "kidsMode"],
          "properties": { "minimumAge": { "type": "integer", "minimum": 0 }, "kidsMode": { "type": "boolean" } }
        },
        "regions": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2}$" } }
      }
    },
    "currencies": {
      "type": "object",
      "required": ["realMoney"],
      "properties": {
        "realMoney": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{3}$" }, "minItems": 1 },
        "virtual": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "purchasable", "showRealMoneyPrice"],
            "properties": { "id": { "type": "string" }, "purchasable": { "type": "boolean" }, "showRealMoneyPrice": { "type": "boolean" } }
          }
        }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["ranked", "practice", "social", "progression"] },
          "countedAttemptsPerDay": { "type": "integer", "minimum": 1 },
          "scope": { "enum": ["group", "everyone"] },
          "boardLabel": { "type": "string" }
        }
      }
    },
    "catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sku", "kind", "grants", "prices", "platformIds", "random"],
        "properties": {
          "sku": { "type": "string" },
          "kind": { "enum": ["consumable", "non_consumable", "subscription", "season"] },
          "grants": { "type": "array", "items": { "type": "string" } },
          "prices": { "type": "object", "additionalProperties": { "type": "number", "exclusiveMinimum": 0 } },
          "platformIds": { "type": "object", "properties": { "stripe": { "type": "string" }, "apple": { "type": "string" }, "google": { "type": "string" } } },
          "random": { "type": "boolean" },
          "odds": { "type": "object", "additionalProperties": { "type": "number" } },
          "priceInVirtual": { "type": "object", "additionalProperties": { "type": "number" } }
        }
      }
    },
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "point", "mode", "sku", "affectsRankedResult", "grantsTo", "countdown", "priceEscalation"],
        "properties": {
          "id": { "type": "string" },
          "point": { "type": "string" },
          "mode": { "type": "string" },
          "sku": { "type": "string" },
          "affectsRankedResult": { "type": "boolean" },
          "grantsTo": { "enum": ["buyer", "group"] },
          "maxPerDay": { "type": "integer", "minimum": 1 },
          "maxPerAttempt": { "type": "integer", "minimum": 1 },
          "countdown": { "type": "boolean" },
          "priceEscalation": { "type": "boolean" }
        }
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "format", "point", "mode", "affectsRankedResult"],
        "properties": {
          "id": { "type": "string" },
          "format": { "enum": ["rewarded", "interstitial", "banner", "app_open", "native"] },
          "point": { "type": "string" },
          "mode": { "type": "string" },
          "affectsRankedResult": { "type": "boolean" },
          "optIn": { "type": "boolean" },
          "grantOn": { "enum": ["completed"] },
          "dailyCap": { "type": "integer", "minimum": 1 },
          "graceLevels": { "type": "integer", "minimum": 0 },
          "graceSeconds": { "type": "integer", "minimum": 0 },
          "cooldownSeconds": { "type": "integer", "minimum": 0 },
          "sessionCap": { "type": "integer", "minimum": 1 },
          "resetAfterRewardedSeconds": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "consent": {
      "type": "object",
      "required": ["requiredBeforeAds"],
      "properties": { "requiredBeforeAds": { "type": "boolean" }, "cmp": { "type": "string" }, "att": { "type": "boolean" } }
    },
    "storeDeclarations": {
      "type": "object",
      "required": ["containsAds", "inAppPurchases", "lootBoxes"],
      "properties": { "containsAds": { "type": "boolean" }, "inAppPurchases": { "type": "boolean" }, "lootBoxes": { "type": "boolean" } }
    },
    "killSwitch": { "type": "string", "minLength": 1 }
  }
}
