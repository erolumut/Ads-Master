{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ads-master/game-monetization/monetization-policy.schema.json",
  "title": "Product monetization policy (contract 0.2)",
  "description": "One file per product (a store listing or web app, which may hold many games). Structure lives here; fairness, consumer and cross reference rules live in monetization_check.py.",
  "type": "object",
  "required": ["contractVersion", "policyRevision", "product", "stores", "currencies", "modes", "catalog", "offers", "placements", "consent", "storeDeclarations", "killSwitch"],
  "$defs": {
    "point": { "type": "string", "pattern": "^(on_[a-z0-9_]+|custom_[a-z0-9_]+)$" },
    "grant": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["cosmetic", "access", "pass", "round", "attempt", "moves", "time", "booster", "currency", "lives", "streak_protection"] },
        "id": { "type": "string" },
        "amount": { "type": "integer", "minimum": 1 },
        "writesTo": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "properties": {
    "contractVersion": { "enum": ["0.1", "0.2"] },
    "policyRevision": { "type": "integer", "minimum": 1 },
    "product": {
      "type": "object",
      "required": ["id", "platforms", "audience"],
      "properties": {
        "id": { "type": "string" },
        "platforms": { "type": "array", "items": { "enum": ["web", "pwa", "ios", "android", "desktop"] }, "minItems": 1 },
        "audience": {
          "type": "object",
          "required": ["minimumAge", "kidsMode"],
          "properties": { "minimumAge": { "type": "integer", "minimum": 0 }, "kidsMode": { "type": "boolean" } }
        },
        "regions": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2}$" } }
      }
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "provider", "platforms"],
        "properties": { "id": { "type": "string" }, "provider": { "type": "string" }, "platforms": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "currencies": {
      "type": "object",
      "properties": {
        "virtual": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "purchasable", "showRealMoneyPrice"],
            "properties": { "id": { "type": "string" }, "purchasable": { "type": "boolean" }, "showRealMoneyPrice": { "type": "boolean" } }
          }
        }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+(:[a-z0-9_-]+)?$" },
          "kind": { "enum": ["ranked", "practice", "social", "progression"] },
          "countedAttemptsPerDay": { "oneOf": [ { "type": "integer", "minimum": 1 }, { "const": "unlimited" } ] },
          "boards": {
            "type": "array",
            "items": { "type": "object", "required": ["id", "scope"], "properties": { "id": { "type": "string" }, "scope": { "enum": ["group", "everyone"] } } }
          }
        }
      }
    },
    "catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sku", "kind", "grants", "basePrice", "storeProductIds", "random"],
        "properties": {
          "sku": { "type": "string" },
          "kind": { "enum": ["consumable", "non_consumable", "subscription", "season"] },
          "grants": { "type": "array", "items": { "$ref": "#/$defs/grant" }, "minItems": 1 },
          "basePrice": {
            "type": "object", "required": ["currency", "minor"],
            "properties": { "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "minor": { "type": "integer", "minimum": 1 } }
          },
          "platformPrices": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } } },
          "storeProductIds": { "type": "object", "additionalProperties": { "type": "string" } },
          "stores": { "type": "array", "items": { "type": "string" } },
          "period": { "type": "string", "pattern": "^P[0-9]+[DWMY]$" },
          "trialDays": { "type": "integer", "minimum": 0 },
          "random": { "type": "boolean" },
          "odds": { "type": "object", "additionalProperties": { "type": "number" } },
          "priceInVirtual": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "point", "mode", "sku", "grantsTo", "countdown", "priceEscalation"],
        "properties": {
          "id": { "type": "string" },
          "point": { "$ref": "#/$defs/point" },
          "mode": { "type": "string" },
          "sku": { "type": "string" },
          "grantsTo": { "enum": ["buyer", "group", "everyone"] },
          "maxPerDay": { "type": "integer", "minimum": 1 },
          "maxPerAttempt": { "type": "integer", "minimum": 1 },
          "countdown": { "type": "boolean" },
          "priceEscalation": { "type": "boolean" }
        }
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "format", "point", "mode"],
        "properties": {
          "id": { "type": "string" },
          "format": { "enum": ["rewarded", "interstitial", "banner", "app_open", "native"] },
          "point": { "$ref": "#/$defs/point" },
          "mode": { "type": "string" },
          "grants": { "type": "array", "items": { "$ref": "#/$defs/grant" } },
          "optIn": { "type": "boolean" },
          "grantOn": { "enum": ["completed"] },
          "dailyCap": { "type": "integer", "minimum": 1 },
          "graceLevels": { "type": "integer", "minimum": 0 },
          "graceSeconds": { "type": "integer", "minimum": 0 },
          "cooldownSeconds": { "type": "integer", "minimum": 0 },
          "sessionCap": { "type": "integer", "minimum": 1 },
          "resetAfterRewardedSeconds": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "consent": {
      "type": "object",
      "required": ["requiredBeforeAds"],
      "properties": { "requiredBeforeAds": { "type": "boolean" }, "cmp": { "type": "string" }, "att": { "type": "boolean" } }
    },
    "storeDeclarations": {
      "type": "object",
      "required": ["containsAds", "inAppPurchases", "lootBoxes"],
      "properties": { "containsAds": { "type": "boolean" }, "inAppPurchases": { "type": "boolean" }, "lootBoxes": { "type": "boolean" } }
    },
    "killSwitch": { "type": "string", "minLength": 1 }
  }
}
